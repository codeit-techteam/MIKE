# Sanity — public (safe for the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=6imjn5c8
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Studio URL used for Visual Editing overlays (local or hosted)
NEXT_PUBLIC_SANITY_STUDIO_URL=https://mike-ai.sanity.studio

# Site URL override for previews (optional; defaults to https://michaelross.ai)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — server only (Viewer token). Never use NEXT_PUBLIC_ for this.
SANITY_API_READ_TOKEN=

# Web3Forms — public access key (safe in the browser; aliases to your inbox).
# Create one at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
